+    download.kind = DemandKind::download;
+
+    const auto playback_only = three_range_plan({playback});
+    const auto concurrent = three_range_plan({download, playback});
+    NUVIO_EXPECT_EQ(concurrent.focused_demand_id, playback.id);
+    NUVIO_EXPECT_EQ(concurrent.deadline_order, playback_only.deadline_order);
+    NUVIO_EXPECT_EQ(priority_for(concurrent, 32), std::optional(PriorityClass::download));
+
+    const auto download_only = three_range_plan({download});
+    NUVIO_EXPECT_TRUE(download_only.deadline_order.empty());
+    NUVIO_EXPECT_EQ(priority_for(download_only, 32), std::optional(PriorityClass::download));
+
+    download.range = playback.range;
+    const auto overlapping = three_range_plan({download, playback});
+    NUVIO_EXPECT_EQ(overlapping.pieces, playback_only.pieces);
+}
